{
  "name": "stackwallet",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "check": "pnpm -r --workspace-concurrency=1 check && tsc -p scripts/tsconfig.json",
    "test": "pnpm -r --workspace-concurrency=1 test --maxWorkers=1 --minWorkers=1 --no-file-parallelism",
    "dev": "pnpm --filter @stackwallet/web dev",
    "desktop": "pnpm --filter @stackwallet/desktop desktop",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,css}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,css}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "probe:rpcs": "node --experimental-strip-types scripts/probe-rpcs.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
