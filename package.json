{
  "name": "stackwallet",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @stackwallet/web dev",
    "desktop": "pnpm --filter @stackwallet/desktop desktop",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,css}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,css}\" --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
