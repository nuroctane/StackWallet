{
  "name": "@stackwallet/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "pnpm build:wasm && tsc -p tsconfig.json --noEmit --pretty false && vite build",
    "build:wasm": "wasm-pack build ../../crates/stackwallet-wasm --target web --release --no-pack --no-typescript --out-dir ../../apps/web/public/wasm --out-name stackwallet_wasm",
    "build:web": "tsc -p tsconfig.json --noEmit --pretty false && vite build",
    "check": "tsc -p tsconfig.json --noEmit --pretty false",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "test": "vitest run --passWithNoTests",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@stackwallet/agent": "workspace:*",
    "@stackwallet/automations": "workspace:*",
    "@stackwallet/chains": "workspace:*",
    "@stackwallet/chains-bitcoin": "workspace:*",
    "@stackwallet/chains-cosmos": "workspace:*",
    "@stackwallet/chains-evm": "workspace:*",
    "@stackwallet/chains-solana": "workspace:*",
    "@stackwallet/collectibles": "workspace:*",
    "@stackwallet/core-client": "workspace:*",
    "@stackwallet/market": "workspace:*",
    "@stackwallet/names": "workspace:*",
    "@stackwallet/tax": "workspace:*",
    "@stackwallet/ui": "workspace:*",
    "@walletconnect/sign-client": "2.25.0",
    "@walletconnect/types": "2.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uqr": "0.1.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "3.2.6",
    "wrangler": "^4.0.0"
  }
}
