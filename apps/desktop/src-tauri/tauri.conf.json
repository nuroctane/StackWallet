{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StackWallet",
  "version": "0.0.1",
  "identifier": "xyz.nuroctane.stackwallet",
  "build": {
    "beforeDevCommand": "pnpm --filter @stackwallet/web dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @stackwallet/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "StackWallet",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#050505"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: wss:; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Every chain. Your devices. Your rules.",
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
